// ============================================================
// 云端剪贴板 Cloud Clipboard v6（Cloudflare Worker + KV）
// v6：下载改为一次性令牌 + 服务器直出附件，绕开 blob 下载在嵌入式预览框里被拦截的问题
// 部署方法：整段替换旧代码，改口令，Deploy。KV 绑定不变（CLIP_KV）。
// ============================================================

// ★★★ 把这里改成你现在正在用的那个口令（保持一致，各设备不用重新输）★★★
const PASSWORD = "change-me-to-a-long-random-password";

const KV_CUR = "current";
const KV_HIS = "history";
const KV_FILES = "files";
const FILE_PREFIX = "file:";
const MAX_FILE_SIZE = 10 * 1024 * 1024; // 10 MB（原始文件大小）
const MAX_FILES = 50;

function json(data, status) {
  return new Response(JSON.stringify(data), {
    status: status || 200,
    headers: { "Content-Type": "application/json; charset=utf-8" }
  });
}

function authed(request) {
  return request.headers.get("X-Key") === PASSWORD;
}

function newId() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;

    if (path === "/" || path === "/index.html") {
      return new Response(PAGE, {
        headers: { "Content-Type": "text/html; charset=utf-8" }
      });
    }

    if (path.indexOf("/api/") === 0) {
      // 凭一次性令牌下载：链接方式打开，不走 X-Key 头校验，令牌本身即凭证（3 分钟失效、用后即焚）
      if (path === "/api/download" && request.method === "GET") {
        if (!env.CLIP_KV) return json({ error: "KV 未绑定" }, 500);
        const token = url.searchParams.get("t") || "";
        if (!token) return json({ error: "缺少令牌" }, 400);
        const fid = await env.CLIP_KV.get("dltoken:" + token);
        if (!fid) return json({ error: "链接已失效，请重新点下载" }, 410);
        await env.CLIP_KV.delete("dltoken:" + token);
        const dlFiles = (await env.CLIP_KV.get(KV_FILES, "json")) || [];
        const df = dlFiles.find(function (x) { return x.id === fid; });
        if (!df) return json({ error: "文件不存在" }, 404);
        const drec = await env.CLIP_KV.get(FILE_PREFIX + df.id, "json");
        if (!drec) return json({ error: "文件内容不存在" }, 404);
        const bin = Uint8Array.from(atob(drec.data), function (c) { return c.charCodeAt(0); });
        const asciiName = df.name.replace(/["\r\n]/g, "_").replace(/[^\x20-\x7E]/g, "_");
        return new Response(bin, {
          headers: {
            "Content-Type": df.type || "application/octet-stream",
            "Content-Disposition": "attachment; filename=\"" + asciiName + "\"; filename*=UTF-8''" + encodeURIComponent(df.name),
            "Content-Length": String(bin.length),
            "Cache-Control": "no-store"
          }
        });
      }
      if (!authed(request)) return json({ error: "口令不正确" }, 401);
      if (!env.CLIP_KV) return json({ error: "KV 未绑定：请到 Worker 的 Settings -> Bindings 里绑定 CLIP_KV" }, 500);

      // ---------- 文字剪贴板 ----------
      if (path === "/api/get" && request.method === "GET") {
        const cur = (await env.CLIP_KV.get(KV_CUR, "json")) || { text: "", updatedAt: 0 };
        const his = (await env.CLIP_KV.get(KV_HIS, "json")) || [];
        return json({ text: cur.text, updatedAt: cur.updatedAt, history: his });
      }

      if (path === "/api/save" && request.method === "POST") {
        const body = await request.json().catch(function () { return {}; });
        const text = typeof body.text === "string" ? body.text : "";
        const now = Date.now();
        const prev = (await env.CLIP_KV.get(KV_CUR, "json")) || { text: "", updatedAt: 0 };
        let his = (await env.CLIP_KV.get(KV_HIS, "json")) || [];
        if (prev.text && prev.text !== text) {
          his.unshift({ text: prev.text, updatedAt: prev.updatedAt });
          his = his.slice(0, 20);
          await env.CLIP_KV.put(KV_HIS, JSON.stringify(his));
        }
        await env.CLIP_KV.put(KV_CUR, JSON.stringify({ text: text, updatedAt: now }));
        return json({ ok: true, updatedAt: now, history: his });
      }

      if (path === "/api/clear" && request.method === "POST") {
        const now = Date.now();
        await env.CLIP_KV.put(KV_CUR, JSON.stringify({ text: "", updatedAt: now }));
        return json({ ok: true, updatedAt: now });
      }

      // ---------- 文件 ----------
      if (path === "/api/files" && request.method === "GET") {
        const files = (await env.CLIP_KV.get(KV_FILES, "json")) || [];
        return json({ files: files });
      }

      if (path === "/api/upload" && request.method === "POST") {
        const body = await request.json().catch(function () { return {}; });
        const name = typeof body.name === "string" && body.name ? body.name : "未命名文件";
        const type = typeof body.type === "string" ? body.type : "";
        const data = typeof body.data === "string" ? body.data : "";
        if (!data) return json({ error: "文件内容为空" }, 400);
        // base64 长度约 4/3 倍，据此估算原始大小
        const approxSize = Math.floor(data.length * 3 / 4);
        if (approxSize > MAX_FILE_SIZE) return json({ error: "文件超过 10 MB 上限" }, 413);
        const id = newId();
        const now = Date.now();
        await env.CLIP_KV.put(FILE_PREFIX + id, JSON.stringify({ name: name, type: type, data: data }));
        let files = (await env.CLIP_KV.get(KV_FILES, "json")) || [];
        files.unshift({ id: id, name: name, size: approxSize, type: type, updatedAt: now });
        // 超出数量上限时，连同最旧的文件数据一起删掉
        while (files.length > MAX_FILES) {
          const old = files.pop();
          if (old && old.id) await env.CLIP_KV.delete(FILE_PREFIX + old.id);
        }
        await env.CLIP_KV.put(KV_FILES, JSON.stringify(files));
        return json({ ok: true, files: files });
      }

      if (path.indexOf("/api/file/") === 0 && request.method === "GET") {
        const id = decodeURIComponent(path.slice("/api/file/".length));
        const rec = await env.CLIP_KV.get(FILE_PREFIX + id, "json");
        if (!rec) return json({ error: "文件不存在" }, 404);
        return json(rec);
      }

      if (path === "/api/download-token" && request.method === "POST") {
        const body = await request.json().catch(function () { return {}; });
        const id = typeof body.id === "string" ? body.id : "";
        const files = (await env.CLIP_KV.get(KV_FILES, "json")) || [];
        if (!files.some(function (f) { return f.id === id; })) return json({ error: "文件不存在" }, 404);
        const token = newId() + newId();
        await env.CLIP_KV.put("dltoken:" + token, id, { expirationTtl: 180 });
        return json({ url: "/api/download?t=" + token });
      }

      if (path === "/api/delete-file" && request.method === "POST") {
        const body = await request.json().catch(function () { return {}; });
        const id = typeof body.id === "string" ? body.id : "";
        if (!id) return json({ error: "缺少文件 id" }, 400);
        await env.CLIP_KV.delete(FILE_PREFIX + id);
        let files = (await env.CLIP_KV.get(KV_FILES, "json")) || [];
        files = files.filter(function (f) { return f.id !== id; });
        await env.CLIP_KV.put(KV_FILES, JSON.stringify(files));
        return json({ ok: true, files: files });
      }

      return json({ error: "not found" }, 404);
    }

    return new Response("Not found", { status: 404 });
  }
};

