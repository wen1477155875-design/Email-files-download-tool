        <div class="dz-hint">单个文件 ≤ 10 MB · 最多保留 50 个</div>
      </div>
      <div class="row">
        <button class="primary" id="uploadBtn">上传</button>
      </div>
      <div class="msg" id="fileMsg"></div>
    </div>
    <div id="fileList" class="group glass rise" style="margin-top:12px"></div>

    <h2 class="sec-title">历史记录</h2>
    <div id="his" class="group glass rise"></div>
  </div>
</div>

<script>
var key = localStorage.getItem("clip_key") || "";
var lastUpdated = 0;
var dirty = false;

function $(id) { return document.getElementById(id); }
function fmt(t) {
  if (!t) return "暂无内容";
  var d = new Date(t);
  function p(n) { return (n < 10 ? "0" : "") + n; }
  return "上次保存：" + d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()) + " " + p(d.getHours()) + ":" + p(d.getMinutes()) + ":" + p(d.getSeconds());
}
function fmtTime(t) {
  if (!t) return "";
  var d = new Date(t);
  function p(n) { return (n < 10 ? "0" : "") + n; }
  return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()) + " " + p(d.getHours()) + ":" + p(d.getMinutes());
}
function fmtSize(n) {
  if (n < 1024) return n + " B";
  if (n < 1024 * 1024) return (n / 1024).toFixed(1) + " KB";
  return (n / 1024 / 1024).toFixed(2) + " MB";
}
function setMsg(s, ok) { var m = $("msg"); m.textContent = s || ""; m.className = "msg " + (ok ? "ok" : "err"); }
function setFileMsg(s, ok) { var m = $("fileMsg"); m.textContent = s || ""; m.className = "msg " + (ok ? "ok" : "err"); }
function headers() { return { "Content-Type": "application/json", "X-Key": key }; }

function showMain() { $("loginBox").classList.add("hidden"); $("mainBox").classList.remove("hidden"); }
function showLogin() { $("mainBox").classList.add("hidden"); $("loginBox").classList.remove("hidden"); }

/* ---------- 主题切换 ---------- */
var SUN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M4.3 4.3l1.6 1.6M18.1 18.1l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.3 19.7l1.6-1.6M18.1 5.9l1.6-1.6"/></svg>';
var MOON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 13.2A8.5 8.5 0 1 1 10.8 3.5a7 7 0 0 0 9.7 9.7Z"/></svg>';
function effectiveTheme() {
  var t = document.documentElement.getAttribute("data-theme");
  if (t) return t;
  return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
}
function paintThemeBtn() {
  var dark = effectiveTheme() === "dark";
  $("themeBtn").innerHTML = dark ? SUN : MOON;
  $("themeBtn").setAttribute("aria-label", dark ? "切换到浅色" : "切换到深色");
}
$("themeBtn").onclick = function () {
  var next = effectiveTheme() === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  try { localStorage.setItem("clip_theme", next); } catch (e) {}
  paintThemeBtn();
};
paintThemeBtn();

function renderHistory(his) {
  var box = $("his");
  box.innerHTML = "";
  if (!his || !his.length) { box.innerHTML = '<div class="empty">暂无历史记录，保存新内容后，旧内容会留在这里。</div>'; return; }
  his.forEach(function (item) {
    var div = document.createElement("div");
    div.className = "his-item";
    var t = document.createElement("div");
    t.className = "his-text";
    t.textContent = item.text;
    var row = document.createElement("div");
    row.className = "his-row";
    var b1 = document.createElement("button");
    b1.textContent = "复制";
    b1.onclick = function () { copyText(item.text); };
    var b2 = document.createElement("button");
    b2.textContent = "载入编辑框";
    b2.onclick = function () { $("txt").value = item.text; dirty = true; setMsg("已载入，记得点保存", true); window.scrollTo(0, 0); };
    var tm = document.createElement("span");
    tm.className = "his-time";
    tm.textContent = fmt(item.updatedAt).replace("上次保存：", "");
    row.appendChild(b1); row.appendChild(b2); row.appendChild(tm);
    div.appendChild(t); div.appendChild(row);
    box.appendChild(div);
  });
}

function renderFiles(files) {
  var box = $("fileList");
  box.innerHTML = "";
  if (!files || !files.length) { box.innerHTML = '<div class="empty">暂无文件，在上方选择文件并上传。</div>'; return; }
  files.forEach(function (f) {
    var div = document.createElement("div");
    div.className = "file-item";
    var nm = document.createElement("div");
    nm.className = "file-name";
    nm.textContent = f.name;
    var row = document.createElement("div");
    row.className = "file-row";
    var b1 = document.createElement("button");
    b1.textContent = "下载";
    b1.onclick = function () { downloadFile(f.id, f.name); };
    var b2 = document.createElement("button");
    b2.textContent = "删除";
    b2.onclick = function () { deleteFile(f.id, f.name); };
    var mt = document.createElement("span");
    mt.className = "file-meta";
    mt.textContent = fmtSize(f.size || 0) + " · " + fmtTime(f.updatedAt);
    row.appendChild(b1); row.appendChild(b2); row.appendChild(mt);
    div.appendChild(nm); div.appendChild(row);
    box.appendChild(div);
  });
}

function copyText(s) {
  function done() { setMsg("已复制到剪贴板", true); }
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(s).then(done, function () { fallback(); });
  } else { fallback(); }
  function fallback() {
    var ta = document.createElement("textarea");
    ta.value = s; document.body.appendChild(ta); ta.select();
    try { document.execCommand("copy"); done(); } catch (e) { setMsg("复制失败，请手动全选复制", false); }
    document.body.removeChild(ta);
  }
}

function load(silent) {
  return fetch("/api/get", { headers: headers() }).then(function (r) {
    if (r.status === 401) { showLogin(); throw new Error("口令不正确"); }
    return r.json();
  }).then(function (d) {
    showMain();
    if (!dirty) { $("txt").value = d.text || ""; }
    lastUpdated = d.updatedAt || 0;
    $("meta").textContent = fmt(lastUpdated) + " · " + (($("txt").value || "").length) + " 字";
    renderHistory(d.history || []);
    if (!silent) setMsg("已拉取最新内容", true);
  }).catch(function (e) { if (!silent) setMsg(String(e.message || e), false); });
}

function loadFiles() {
  return fetch("/api/files", { headers: headers() }).then(function (r) {
    return r.json();
  }).then(function (d) {
    if (d && d.files) renderFiles(d.files);
  }).catch(function () {});
}

function downloadFile(id, name) {
  setFileMsg("正在准备下载 " + name + " …", true);
  fetch("/api/download-token", { method: "POST", headers: headers(), body: JSON.stringify({ id: id }) })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d || d.error || !d.url) { setFileMsg("下载失败：" + ((d && d.error) || "无法生成下载链接"), false); return; }
      var a = document.createElement("a");
      a.href = d.url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setFileMsg("已开始下载 " + name, true);
    })
    .catch(function (e) { setFileMsg("下载失败：" + e.message, false); });
}

function deleteFile(id, name) {
  if (!confirm("确定要删除文件「" + name + "」吗？")) return;
  fetch("/api/delete-file", { method: "POST", headers: headers(), body: JSON.stringify({ id: id }) })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d.error) { setFileMsg(d.error, false); return; }
      renderFiles(d.files || []);
      setFileMsg("已删除 " + name, true);
    })
    .catch(function (e) { setFileMsg("删除失败：" + e.message, false); });
}

/* ---------- 拖放区 ---------- */
function showPicked(f) {
  if (f) $("dzText").textContent = f.name + "（" + fmtSize(f.size) + "）— 点下方「上传」发送";
}
$("fileInput").addEventListener("change", function () {
  if (this.files && this.files.length) showPicked(this.files[0]);
});
["dragenter", "dragover"].forEach(function (ev) {
  $("dz").addEventListener(ev, function (e) { e.preventDefault(); $("dz").classList.add("over"); });
});
["dragleave", "drop"].forEach(function (ev) {
  $("dz").addEventListener(ev, function (e) { e.preventDefault(); $("dz").classList.remove("over"); });
});
$("dz").addEventListener("drop", function (e) {
  var files = e.dataTransfer && e.dataTransfer.files;
  if (files && files.length) {
    try { $("fileInput").files = files; } catch (err) {}
    showPicked(files[0]);
  }
});

$("uploadBtn").onclick = function () {
  var input = $("fileInput");
  if (!input.files || !input.files.length) { setFileMsg("先点「选择文件」选一个文件", false); return; }
  var file = input.files[0];
  if (file.size > 10 * 1024 * 1024) { setFileMsg("文件超过 10 MB 上限", false); return; }
  setFileMsg("正在读取并上传 " + file.name + " …", true);
  var reader = new FileReader();
  reader.onload = function () {
    var dataUrl = String(reader.result || "");
    var comma = dataUrl.indexOf(",");
    var base64 = comma >= 0 ? dataUrl.slice(comma + 1) : "";
    fetch("/api/upload", { method: "POST", headers: headers(), body: JSON.stringify({ name: file.name, type: file.type || "", data: base64 }) })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.error) { setFileMsg("上传失败：" + d.error, false); return; }
        renderFiles(d.files || []);
        input.value = "";
        $("dzText").textContent = "点击选择文件，或把文件拖到这里";
        setFileMsg("已上传 " + file.name, true);
      })
      .catch(function (e) { setFileMsg("上传失败：" + e.message, false); });
  };
  reader.onerror = function () { setFileMsg("读取文件失败", false); };
  reader.readAsDataURL(file);
};

$("loginBtn").onclick = function () {
  key = $("pw").value;
  if (!key) { $("loginMsg").textContent = "口令不能为空"; return; }
  localStorage.setItem("clip_key", key);
  load(false).then(function () { $("loginMsg").textContent = ""; loadFiles(); }).catch(function () {
    $("loginMsg").textContent = "口令不正确，请重试";
    localStorage.removeItem("clip_key");
  });
};
$("pw").addEventListener("keydown", function (e) { if (e.key === "Enter") $("loginBtn").click(); });

$("txt").addEventListener("input", function () {
  dirty = true;
  $("meta").textContent = fmt(lastUpdated) + " · " + $("txt").value.length + " 字（未保存）";
});

$("saveBtn").onclick = function () {
  fetch("/api/save", { method: "POST", headers: headers(), body: JSON.stringify({ text: $("txt").value }) })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d.error) { setMsg(d.error, false); return; }
      dirty = false; lastUpdated = d.updatedAt;
      $("meta").textContent = fmt(lastUpdated) + " · " + $("txt").value.length + " 字";
      renderHistory(d.history || []);
      setMsg("已保存到云端 ✓", true);
    })
    .catch(function (e) { setMsg("保存失败：" + e.message, false); });
};

$("copyBtn").onclick = function () { copyText($("txt").value); };
$("refreshBtn").onclick = function () {
  if (dirty && !confirm("你有未保存的修改，拉取最新会覆盖，确定吗？")) return;
  dirty = false; load(false); loadFiles();
};
$("clearBtn").onclick = function () {
  if (!confirm("确定要清空云端当前内容吗？（历史里还能找回）")) return;
  fetch("/api/clear", { method: "POST", headers: headers(), body: "{}" })
    .then(function () { $("txt").value = ""; dirty = false; setMsg("已清空", true); load(true); });
};
$("logoutBtn").onclick = function () { localStorage.removeItem("clip_key"); key = ""; showLogin(); };

if (key) { load(true); loadFiles(); } else { showLogin(); }
setInterval(function () { if (key && !dirty) load(true); }, 5000);
</script>
</body>
</html>
`;
